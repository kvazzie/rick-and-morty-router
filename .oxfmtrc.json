{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "dev-dist"],
  "indentStyle": "space",
  "indentWidth": 2,
  "lineWidth": 120,
  "quoteStyle": "single",
  "semicolons": true,
  "trailingCommas": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "editorconfig": true
}
